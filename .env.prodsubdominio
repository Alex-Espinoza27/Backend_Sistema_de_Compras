# =============================================================================
# PRODUCCIÓN con subdominio y HTTPS (servidor público).
# Réplica del .env actual de prod (172.17.2.249:8090) SIN credenciales.
# Uso: copiar como `.env`, completar los [COMPLETAR] y correr
#   php artisan config:cache
# Dominio de ejemplo: compras.munilaperla.gob.pe -> reemplazar por el real.
# Las líneas "# CAMBIA:" son las únicas que difieren del .env por IP:puerto.
# =============================================================================

APP_NAME="Compras La Perla"
APP_ENV=production
# [COMPLETAR] Copiar la APP_KEY del .env actual (conserva cookies y datos
# cifrados válidos) o generar otra con `php artisan key:generate`.
APP_KEY=
# CAMBIA: en un servidor público debe ser false (con true los errores
# devuelven rutas, SQL y datos internos al navegador).
APP_DEBUG=false
# CAMBIA: dominio con https, sin puerto.
APP_URL=https://compras.munilaperla.gob.pe
APP_TIMEZONE=America/Lima


APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
COMPRAS_DB_HOST=127.0.0.1
COMPRAS_DB_PORT=5432
COMPRAS_DB_DATABASE=compras_laperla
# [COMPLETAR]
COMPRAS_DB_USERNAME=
# [COMPLETAR]
COMPRAS_DB_PASSWORD=
DB_TIMEZONE=America/Lima

# Sanctum / CORS (SPA)
# CAMBIA: host exacto desde donde se abre el sistema, sin esquema ni puerto.
# Si el SPA y la API quedan en subdominios distintos, listar el del SPA
# (ej. app.munilaperla.gob.pe) y el de la API, separados por coma.
SANCTUM_STATEFUL_DOMAINS=compras.munilaperla.gob.pe
SESSION_DRIVER=cookie
# CAMBIA: 24 h (antes 120). SESSION_LIFETIME es por inactividad y
# SESSION_ABSOLUTE_LIFETIME el tope desde el login aunque haya actividad;
# ambos en minutos.
SESSION_LIFETIME=1440
SESSION_ABSOLUTE_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
# CAMBIA: antes era la IP. `null` = cookie solo para este host (lo más seguro
# si el SPA y la API comparten dominio). Solo si van en subdominios distintos:
# SESSION_DOMAIN=.munilaperla.gob.pe (la cookie viaja a TODOS los
# subdominios; por eso cada proyecto debe tener su SESSION_COOKIE propio).
SESSION_DOMAIN=null
SESSION_COOKIE=compras_session
# CAMBIA: origen del SPA con esquema, sin barra final.
FRONTEND_URL=https://compras.munilaperla.gob.pe

# CAMBIA: activado (estaba comentado). Con HTTPS la cookie nunca viaja por
# HTTP plano. Si se activa sin HTTPS, nadie puede iniciar sesión.
SESSION_SECURE_COOKIE=true


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=net02usa.nethostingsac.com
MAIL_PORT=465
# [COMPLETAR]
MAIL_USERNAME=
# [COMPLETAR]
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="compras@munilaperla.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Servicios propios (02A §7)
CAPTCHA_DRIVER=interno
SUNAT_API_URL=https://api.factiliza.com/v1/ruc/info/
# [COMPLETAR]
SUNAT_TOKEN=
ARCHIVO_MAX_MB=10
ARCHIVO_MIME_PERMITIDOS=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Respaldo automático
BACKUP_HORA=02:00
BACKUP_RETENCION_DIAS=14
