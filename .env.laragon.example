## Plantilla de .env para correr el backend con Laragon (Apache/Nginx + PHP +
## PostgreSQL nativos de Windows), en vez de Docker. Copiar a `.env`:
##   cp .env.laragon.example .env
## y ajustar los valores marcados con "<<<" según tu propio Laragon
## (nombre del vhost, usuario/clave de PostgreSQL que hayas creado).
##
## Ver 07_DESARROLLO_LARAGON.md (raíz del repo) para la guía completa —
## en particular, por qué SANCTUM_STATEFUL_DOMAINS debe ser el dominio del
## backend (no localhost:5173) cuando el frontend corre con el proxy de
## Vite (`VITE_PROXY_TARGET`, ver Frontend_Sistema_de_Compras/.env.laragon.example).

APP_NAME="Compras La Perla"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# <<< Dominio que Laragon asignó a esta carpeta (clic derecho en Laragon →
# "Pretty URL" para renombrarlo si el automático es feo). Debe coincidir con
# SANCTUM_STATEFUL_DOMAINS y con VITE_PROXY_TARGET del frontend.
APP_URL=http://compras-laperla.test
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL nativo de Laragon (o el servicio Postgres que hayas instalado
# aparte — Laragon no lo trae por defecto, solo MySQL). DB_HOST es
# 127.0.0.1, nunca "db" (ese hostname solo existe dentro de la red de Docker).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=compras_laperla
DB_USERNAME=compras
DB_PASSWORD=secret
DB_TIMEZONE=America/Lima

# Sanctum / CORS (SPA) — con el proxy de Vite (VITE_PROXY_TARGET) el
# navegador solo habla con localhost:5173, pero el proxy reescribe el
# Origin/Referer de cada request para que, desde la óptica de Laravel, el
# pedido venga del propio dominio del backend. Por eso aquí va el dominio
# del backend, no "localhost:5173" (ese valor es el que usa el modo Docker).
SANCTUM_STATEFUL_DOMAINS=compras-laperla.test
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Vacío a propósito: el proxy de Vite reescribe el dominio de la cookie a
# "localhost" él mismo (`cookieDomainRewrite`) antes de que el navegador la
# reciba — si se fija aquí un dominio distinto, se pisan entre sí.
SESSION_DOMAIN=
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Correo: Laragon no trae Mailpit. `log` escribe los correos en
# storage/logs/laravel.log en vez de intentar enviarlos — suficiente para
# desarrollo. Si instalaste Mailpit aparte (standalone para Windows),
# cambia a MAIL_MAILER=smtp + MAIL_HOST=127.0.0.1 + MAIL_PORT=1025.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@munilaperla.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Servicios propios (02A §7)
CAPTCHA_DRIVER=interno
SUNAT_API_URL=
SUNAT_TOKEN=
ARCHIVO_MAX_MB=10
ARCHIVO_MIME_PERMITIDOS=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Respaldo automático
BACKUP_HORA=02:00
BACKUP_RETENCION_DIAS=14
